# Azure SQL (origen)
MSSQL_HOST=goreplica.database.windows.net
MSSQL_DB=goMedisysCo_ClinicaSantaBarbara
MSSQL_USER=goDBExternalCACSBarbara
MSSQL_PASS=CAMBIAR_POR_VALOR_REAL

# Supabase PostgreSQL (destino)
