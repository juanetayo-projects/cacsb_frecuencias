# ============================================================
#  CACSB Frecuencias — Variables de entorno Next.js
#  Copiar como .env.local y completar con valores reales
#  NUNCA subir .env.local a GitHub
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[ID-PROYECTO].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON-KEY-AQUI]
SUPABASE_SERVICE_ROLE_KEY=[SERVICE-ROLE-KEY-AQUI]

# ── Resend (email) ───────────────────────────────────────────
RESEND_API_KEY=[API-KEY-RESEND]

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Control de Contratos CACSB
NEXT_PUBLIC_APP_URL=http://localhost:3000
